generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CategoryGroup {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[]

  @@index([isActive])
  @@index([sortOrder])
}

model Category {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  image           String?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  categoryGroupId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  categoryGroup   CategoryGroup? @relation(fields: [categoryGroupId], references: [id])
  products        Product[]

  @@index([categoryGroupId])
  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  longDescription  String?
  featuredImage    String?
  isActive         Boolean          @default(true)

  categoryId       String?
  brandId          String

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  category         Category?        @relation(fields: [categoryId], references: [id])
  brand            Brand           @relation(fields: [brandId], references: [id])

  images           ProductImage[]
  variants         ProductVariant[]
  outfits          OutfitProduct[]
  tags             Tag[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id                 String        @id @default(cuid())
  productId          String
  sku                String        @unique
  colorId            String?
  sizeId             String?
  price              Decimal       @db.Decimal(12, 2)
  percentageDiscount Decimal       @default(0) @db.Decimal(5, 2)
  stock              Int           @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  color              ProductColor? @relation(fields: [colorId], references: [id])
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  size               ProductSize?  @relation(fields: [sizeId], references: [id])

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([isActive])
}

model ProductColor {
  id        String           @id @default(cuid())
  name      String
  label     String
  hex       String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductSize {
  id        String           @id @default(cuid())
  name      String
  label     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductImage {
  id             String   @id @default(cuid())
  url            String
  alt            String?
  imageKitFileId String?
  productId      String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([imageKitFileId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  outfits     Outfit[]

  @@index([slug])
}

model Outfit {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  longDescription  String?
  shortDescription String?
  featuredImage    String?
  isActive         Boolean         @default(true)
  collectionId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  collection       Collection?     @relation(fields: [collectionId], references: [id])
  images           OutfitImage[]
  products         OutfitProduct[]
  tags             Tag[]

  @@index([collectionId])
  @@index([isActive])
}

model OutfitImage {
  id             String   @id @default(cuid())
  url            String
  alt            String?
  imageKitFileId String?
  outfitId       String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  outfit         Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([imageKitFileId])
}

model OutfitProduct {
  outfitId  String
  productId String
  sortOrder Int     @default(0)
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([outfitId, productId])
  @@index([productId])
}

model Brand {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  shortDescription String?
  longDescription  String?
  featuredImage    String?
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products         Product[]

  @@index([isActive])
  @@index([sortOrder])
}

model Tag {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  products   Product[]
  outfits    Outfit[]

  @@index([sortOrder])
}


model Customer {
  id        String   @id @default(cuid())

  name      String
  email     String   @unique
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([email])
  @@index([phone])
}


model Order {
  id              String      @id @default(cuid())

  orderNumber     String      @unique

  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])

  // Customer information snapshot
  customerName    String
  customerEmail   String
  customerPhone   String?

  // Shipping information snapshot
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingCountry String

  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)

  status          OrderStatus @default(PENDING)

  items           OrderItem[]
  payment         Payment?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}


model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  order       Order    @relation( fields: [orderId], references: [id], onDelete: Cascade )

  productId   String
  variantId   String

  // Product snapshot
  productName  String
  featuredImage String?
  slug         String
  category     String

  // Variant snapshot
  sku          String
  color        String?
  size         String?

  // Purchase information
  quantity     Int

  // Pricing snapshot
  price              Decimal @db.Decimal(12, 2)
  percentageDiscount Decimal @db.Decimal(5, 2)
  finalUnitPrice Decimal @db.Decimal(12, 2)

  // Final calculated price for this line
  totalPrice         Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}


model Payment {
  id              String        @id @default(cuid())

  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reference       String        @unique

  gateway         String        @default("paystack")

  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("NGN")

  status          PaymentStatus @default(PENDING)

  paidAt          DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reference])
  @@index([status])
}


enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}


enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}